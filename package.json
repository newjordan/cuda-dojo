{
  "name": "cuda-dojo",
  "version": "0.1.0",
  "description": "Public GPU chess research repo focused on CUDA engine architecture, oracle baselines, and training loops.",
  "type": "module",
  "private": false,
  "scripts": {
    "oracle:sigma": "make -C cuda oracle_sigma_smoke",
    "oracle:probe": "make -C cuda oracle_sigma_probe",
    "accuracy:gpu-fighter-external-baseline": "node fighter_accuracy/scripts/run_external_accuracy_gate.mjs --expect-fail",
    "accuracy:gpu-fighter-external-snapshot": "node fighter_accuracy/scripts/run_external_accuracy_gate.mjs --skip-run --expect-fail",
    "accuracy:gpu-fighter-baseline": "node scripts/run_cpu_gpu_accuracy_matrix.mjs --timeout-ms 300000",
    "accuracy:gpu-fighter-gate": "node scripts/run_cpu_gpu_accuracy_matrix.mjs --timeout-ms 300000",
    "accuracy:trace-first": "node scripts/trace_first_disagreement.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/newjordan/cuda-dojo.git"
  },
  "bugs": {
    "url": "https://github.com/newjordan/cuda-dojo/issues"
  },
  "homepage": "https://github.com/newjordan/cuda-dojo#readme",
  "license": "ISC"
}
